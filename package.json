{
  "name": "coachify-desktop-workspace",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "ui:dev": "pnpm --dir ui dev",
    "ui:build": "pnpm --dir ui build",
    "gen": "cargo run -p xtask export-types",
    "lint": "pnpm --dir ui lint",
    "format:check": "pnpm --dir ui format:check",
    "format": "pnpm --dir ui format",
    "typecheck": "pnpm --dir ui typecheck",
    "test": "pnpm --dir ui test",
    "check-types": "cargo run -p xtask check-types",
    "check-migrations": "cargo run -p xtask check-migrations",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0"
  }
}
